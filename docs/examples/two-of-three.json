    "launchAgentAtLogin": false,
    "launchGuiAtLogin": false,
    "closeWindowAction": "quit-gui",
    "notifications": "errors-only",
    "startupDelayMs": 0,
    "lastPage": "dashboard",
    "logRetentionDays": 14,
    "logMaxBytes": 20971520
  },
  "safety": {
    "globalMonitorCooldownMs": 5000,
    "startupGraceMs": 3000,
    "resumeGraceMs": 4000,
    "defaultDebounceMs": 400,
    "commandTimeoutMs": 2000
  },
  "usbDevices": [
    {
      "id": "device_0",
      "alias": "Example USB 0",
      "enabled": true,
      "selectors": [
        {
          "id": "selector_0",
          "strategy": "vid-pid",
          "vid": 1133,
          "pid": 1000,
          "serial": null,
          "path": null,
          "allowAmbiguous": false
        }
      ]
    },
    {
      "id": "device_1",
      "alias": "Example USB 1",
      "enabled": true,
      "selectors": [
        {
          "id": "selector_1",
          "strategy": "vid-pid",
          "vid": 1133,
          "pid": 1001,
          "serial": null,
          "path": null,
          "allowAmbiguous": false
        }
      ]
    },
    {
      "id": "device_2",
      "alias": "Example USB 2",
      "enabled": true,
      "selectors": [
        {
          "id": "selector_2",
          "strategy": "vid-pid",
          "vid": 1133,
          "pid": 1002,
          "serial": null,
          "path": null,
          "allowAmbiguous": false
        }
      ]
